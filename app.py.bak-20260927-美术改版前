def _start(kind: str) -> None:
    """kind: 'intake' 丢材料 / 'self' 三个数 / 'example' 看例子"""
    ss = st.session_state
    if kind == "example":
        _d = {i.key: i.default for i in current_module().INPUTS}
        _c0 = make_case(_d, {})
        ss["case"] = _c0
        ss["inputs"] = _d
        ss["width_before"] = _c0.headline_high - _c0.headline_low
        ss["step"] = "report"
        ss["answers"] = {}
        ss["qIndex"] = 0
        ss["summary"] = None
        ss["example"] = True
        ss.pop("qorder", None)
        ss["screen"] = "app"
    elif kind == "intake":
        ss["screen"] = "intake"
    else:
        ss.pop("qorder", None)
        ss["screen"] = "app"
    st.rerun()


